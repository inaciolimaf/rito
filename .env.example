# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_ENV=development                # development | test | production
APP_NAME=Rito
SECRET_KEY=troque-isto-em-producao
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rito:rito@localhost:5432/rito
TEST_DATABASE_URL=postgresql+asyncpg://rito:rito@localhost:5432/rito_test

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Storage (MinIO em dev, S3 em produção) ───────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rito
S3_REGION=us-east-1

# ─── OpenRouter (único gateway de LLM) ────────────────────────────────────────
# Gere em https://openrouter.ai/keys — necessário só a partir da spec 081.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Rito
OPENROUTER_SITE_URL=https://rito.app
# Modelos padrão por perfil de uso. O usuário sobrescreve por feature na UI
# (tabela ai_feature_config) — estes valores são apenas o fallback inicial.
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_LONG_CONTEXT=

# ─── DJEN — Diário de Justiça Eletrônico Nacional ─────────────────────────────
# API pública do CNJ. NÃO exige autenticação — exige user-agent de browser.
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
DJEN_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36
DJEN_RATE_LIMIT_PER_MINUTE=30
DJEN_SYNC_CRON=0 6 * * *

# ─── DataJud — Base de Dados do Poder Judiciário (CNJ) ────────────────────────
# Chave PÚBLICA publicada pelo CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Não é credencial pessoal. O CNJ pode rotacioná-la a qualquer momento —
# a aplicação deve alertar em 401 e apontar para a wiki.
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_RATE_LIMIT_PER_MINUTE=60
DATAJUD_SYNC_CRON=0 7 * * *

# ─── E-mail ───────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@rito.app

# ─── Observabilidade ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Testes ───────────────────────────────────────────────────────────────────
# Parâmetros reduzidos do Argon2 para não estourar o orçamento de 120s.
# Os valores de produção têm teste dedicado.
TEST_ARGON2_TIME_COST=1
TEST_ARGON2_MEMORY_COST=8192
TEST_WALL_CLOCK_BUDGET_SECONDS=120
