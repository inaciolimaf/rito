# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_ENV=development                # development | test | production
APP_NAME=Rito
SECRET_KEY=troque-isto-em-producao
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# CSV de origens do frontend autorizadas por CORS (backend e frontend rodam em portas diferentes em dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Banco de dados ───────────────────────────────────────────────────────────
# DATABASE_URL usa a role de aplicação `rito_app` — sem BYPASSRLS (CLAUDE.md §4).
# MIGRATIONS_DATABASE_URL usa o superusuário — só para `alembic upgrade`, nunca em runtime.
DATABASE_URL=postgresql+asyncpg://rito_app:rito_app@localhost:5432/rito
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://rito:rito@localhost:5432/rito
TEST_DATABASE_URL=postgresql+asyncpg://rito_app:rito_app@localhost:5432/rito_test
TEST_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://rito:rito@localhost:5432/rito_test

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Storage (MinIO em dev, S3 em produção) ───────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rito
S3_REGION=us-east-1
# Bucket de teste separado do de dev (mesmo MinIO local) — spec 011.
TEST_S3_ENDPOINT_URL=http://localhost:9000
TEST_S3_ACCESS_KEY=minioadmin
TEST_S3_SECRET_KEY=minioadmin
TEST_S3_BUCKET=rito-test
TEST_S3_REGION=us-east-1

# ─── OpenRouter (único gateway de LLM) ────────────────────────────────────────
# Gere em https://openrouter.ai/keys — necessário só a partir da spec 081.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Rito
OPENROUTER_SITE_URL=https://rito.app
# Modelo padrão e reserva. O escritório sobrescreve por feature na UI (tabela
# ai_feature_config, spec 081) — estes valores só valem para feature ainda sem
# configuração própria. São os ÚNICOS lugares onde um id de modelo pode aparecer.
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=
# Teto de chamadas por minuto ao gateway, por host (camada 041).
OPENROUTER_RATE_LIMIT_PER_MINUTE=60

# ─── DJEN — Diário de Justiça Eletrônico Nacional ─────────────────────────────
# API pública do CNJ. NÃO exige autenticação — exige user-agent de browser.
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1
DJEN_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36
DJEN_RATE_LIMIT_PER_MINUTE=30
DJEN_SYNC_CRON=0 6 * * *

# ─── DataJud — Base de Dados do Poder Judiciário (CNJ) ────────────────────────
# Chave PÚBLICA publicada pelo CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Não é credencial pessoal. O CNJ pode rotacioná-la a qualquer momento —
# a aplicação deve alertar em 401 e apontar para a wiki.
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_RATE_LIMIT_PER_MINUTE=60
DATAJUD_SYNC_CRON=0 7 * * *

# ─── E-mail ───────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@rito.app

# ─── Observabilidade (spec 097) ───────────────────────────────────────────────
# Regra 10: o nível é ajustável sem redeploy.
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_SERVICE_NAME=rito-api
# Regra 11: 10% do tráfego normal. O que termina em erro é exportado SEMPRE, sorteado ou
# não — a amostragem vale só para o caminho feliz.
OTEL_SAMPLE_RATIO=0.1
# Sem endpoint o trace fica no processo e nada é exportado (o Rito só exporta; quem
# hospeda o backend de trace é o time de infra). É o modo de dev e o de teste.
OTEL_EXPORTER_OTLP_ENDPOINT=
# /metrics é inventário da operação (custo de LLM, tráfego por rota). Com token, exige
# `Authorization: Bearer <token>`; sem token, depende do isolamento de rede do scrape.
METRICS_TOKEN=

# ─── Testes ───────────────────────────────────────────────────────────────────
# Parâmetros reduzidos do Argon2 para não estourar o orçamento de 120s.
# Os valores de produção têm teste dedicado.
TEST_ARGON2_TIME_COST=1
TEST_ARGON2_MEMORY_COST=8192
TEST_WALL_CLOCK_BUDGET_SECONDS=120
# Redis de teste usa um índice de banco separado (15) do de desenvolvimento (0).
TEST_REDIS_URL=redis://localhost:6379/15
