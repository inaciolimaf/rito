# Configuração de produção (spec 099, regra 5). Copie para `.env.production`, preencha e
# NÃO versione. O boot recusa subir listando tudo que faltar.

APP_ENV=production
# Regra 6: gere o seu. `openssl rand -hex 32`. O valor de exemplo do .env.example é
# público e a aplicação se recusa a subir com ele.
SECRET_KEY=

POSTGRES_USER=rito
POSTGRES_PASSWORD=
POSTGRES_DB=rito

# `rito_app` é a role SEM BYPASSRLS — é ela que a aplicação usa, e é o que faz o
# isolamento entre escritórios valer mesmo com uma query crua (CLAUDE.md §4).
DATABASE_URL=postgresql+asyncpg://rito_app:TROQUE@postgres:5432/rito
# Superusuário, usado só para aplicar migration. Nunca em runtime.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://rito:TROQUE@postgres:5432/rito

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# O domínio de onde o frontend é servido. Localhost aqui é recusado no boot.
CORS_ALLOWED_ORIGINS=https://app.seuescritorio.com.br
# Entra no bundle em tempo de build (ver frontend/Dockerfile).
VITE_API_BASE_URL=https://api.seuescritorio.com.br

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rito
S3_REGION=us-east-1

# Opcionais — cada um desliga a funcionalidade correspondente quando vazio.
OPENROUTER_API_KEY=
DATAJUD_API_KEY=
DJEN_USER_AGENT=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
